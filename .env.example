# GitHub API Backend Environment Configuration
# Copy this file to .env and update with your values

# GitHub Personal Access Token (optional but recommended)
# Get one at: https://github.com/settings/tokens
# Increases rate limit from 60 to 5000 requests per hour
GITHUB_TOKEN=your_github_token_here

# Hybrid System Configuration (optional)
# Set these to fetch and merge data from two accounts
PRIMARY_GITHUB_USERNAME=your_primary_username
ALT_GITHUB_USERNAME=your_alt_username
ALT_GITHUB_TOKEN=your_alt_github_token_here

# Language weighting (optional)
# Boost specific languages by a multiplier. Format: Language:Multiplier,Language:Multiplier
# Example: Rust:2.5,TypeScript:0.5 (Makes Rust appear 2.5x more prominent)
LANGUAGE_WEIGHTS=Rust:2.0

# Allowed CORS origins (comma-separated)
# Add your frontend domains here
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com,https://yourapp.netlify.app

# Environment mode
NODE_ENV=development

# Port for local development (ignored in Netlify)
PORT=3001